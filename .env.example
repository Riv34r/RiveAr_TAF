# Environment variables - DO NOT commit real secrets here
# Copy to `.env`. The defaults below match a stock local Docker Compose stack
# of the RiveAr application, so no edits are needed for local runs.
#
# Note there are deliberately no credentials here: the framework reads the
# seeded accounts and their password from the SUT's own
# GET /api/v1/test/seed-manifest endpoint at runtime.

BASE_URL=http://localhost:8000
API_PREFIX=/api/v1
