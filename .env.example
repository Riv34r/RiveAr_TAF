# Environment variables - DO NOT commit real secrets here
# Copy to `.env`. The defaults below match a stock local Docker Compose stack
# of the RiveAr application, so no edits are needed for local runs.
#
# Note there are deliberately no credentials here: the framework reads the
# seeded accounts and their password from the SUT's own
# GET /api/v1/test/seed-manifest endpoint at runtime.

BASE_URL=http://localhost:8000
API_PREFIX=/api/v1

# For the DB layer (tests/db) - direct Postgres connection, read from the
# same stock local Docker Compose stack. Unlike the API layer, there's no
# runtime endpoint to fetch credentials from, so they're spelled out here -
# same values as RiveAr's own root .env.example, not real secrets.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rivear
DB_USER=rivear
DB_PASSWORD=rivear_dev_password
